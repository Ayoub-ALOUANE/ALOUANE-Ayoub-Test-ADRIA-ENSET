# Multi-stage build for any Spring Boot module
# Usage: docker build --build-arg MODULE=account-service -f Dockerfile.service -t bank/account-service .
ARG MODULE=account-service

FROM maven:3.9.9-eclipse-temurin-17 AS build
ARG MODULE
WORKDIR /workspace
COPY pom.xml .
COPY config-server/pom.xml config-server/
COPY discovery-service/pom.xml discovery-service/
COPY gateway-service/pom.xml gateway-service/
COPY account-service/pom.xml account-service/
COPY transaction-service/pom.xml transaction-service/
COPY notification-service/pom.xml notification-service/
COPY ai-assistant/pom.xml ai-assistant/
RUN mvn -B -q -DskipTests dependency:go-offline || true
COPY . .
RUN mvn -B -pl ${MODULE} -am -DskipTests package

FROM eclipse-temurin:17-jre
ARG MODULE
WORKDIR /app
COPY --from=build /workspace/${MODULE}/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
